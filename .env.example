POSTGRES_DB=pi_printserver
POSTGRES_USER=pi_printserver
# Replace all three change-me values before starting. Passwords may contain symbols.
POSTGRES_PASSWORD=change-me-database-password
SECRET_KEY=change-me-generate-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password-minimum-12-characters
FRONTEND_PORT=8080
# For HTTPS behind a reverse proxy use true and set the browser's exact origin.
COOKIE_SECURE=false
PUBLIC_ORIGIN=
TIMEZONE=Europe/Prague
SESSION_HOURS=12
PRINTER_TIMEOUT=5
DEFAULT_PRINT_QUANTITY=1
MAX_PRINT_QUANTITY=500
REASON_REQUIRED=true
